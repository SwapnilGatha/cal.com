# Production-optimized multi-stage Dockerfile for Cal.com Web (Next.js)
# Expected size: ~800MB-1.2GB (down from ~5GB)

# Stage 1: Install production dependencies
FROM node:20-alpine AS deps

WORKDIR /calcom

# Install dependencies for native modules
RUN apk add --no-cache libc6-compat openssl

# Copy dependency files
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn ./.yarn

# Install dependencies (skip scripts for Docker build)
RUN yarn config set httpTimeout 1200000 && \
    YARN_ENABLE_SCRIPTS=false yarn install && \
    rm -rf .yarn/cache

# Stage 2: Build application
FROM node:20-alpine AS builder

WORKDIR /calcom

# Build arguments
ARG NEXT_PUBLIC_LICENSE_CONSENT
ARG NEXT_PUBLIC_WEBSITE_TERMS_URL
ARG NEXT_PUBLIC_WEBSITE_PRIVACY_POLICY_URL
ARG CALCOM_TELEMETRY_DISABLED
ARG DATABASE_URL
ARG NEXTAUTH_SECRET=secret
ARG CALENDSO_ENCRYPTION_KEY=secret
ARG MAX_OLD_SPACE_SIZE=6144
ARG NEXT_PUBLIC_API_V2_URL
ARG CSP_POLICY
ARG NEXT_PUBLIC_SINGLE_ORG_SLUG
ARG ORGANIZATIONS_ENABLED

# Environment variables for build
ENV NEXT_PUBLIC_WEBAPP_URL=http://NEXT_PUBLIC_WEBAPP_URL_PLACEHOLDER \
    NEXT_PUBLIC_API_V2_URL=$NEXT_PUBLIC_API_V2_URL \
    NEXT_PUBLIC_LICENSE_CONSENT=$NEXT_PUBLIC_LICENSE_CONSENT \
    NEXT_PUBLIC_WEBSITE_TERMS_URL=$NEXT_PUBLIC_WEBSITE_TERMS_URL \
    NEXT_PUBLIC_WEBSITE_PRIVACY_POLICY_URL=$NEXT_PUBLIC_WEBSITE_PRIVACY_POLICY_URL \
    CALCOM_TELEMETRY_DISABLED=$CALCOM_TELEMETRY_DISABLED \
    DATABASE_URL=$DATABASE_URL \
    DATABASE_DIRECT_URL=$DATABASE_URL \
    NEXTAUTH_SECRET=${NEXTAUTH_SECRET} \
    CALENDSO_ENCRYPTION_KEY=${CALENDSO_ENCRYPTION_KEY} \
    NEXT_PUBLIC_SINGLE_ORG_SLUG=$NEXT_PUBLIC_SINGLE_ORG_SLUG \
    ORGANIZATIONS_ENABLED=$ORGANIZATIONS_ENABLED \
    NODE_OPTIONS=--max-old-space-size=${MAX_OLD_SPACE_SIZE} \
    BUILD_STANDALONE=true \
    CSP_POLICY=$CSP_POLICY

# Install build dependencies
RUN apk add --no-cache libc6-compat openssl python3 make g++

# Copy all dependency files
COPY package.json yarn.lock .yarnrc.yml playwright.config.ts turbo.json i18n.json ./
COPY .yarn ./.yarn

# Copy source code
COPY apps/web ./apps/web
COPY apps/api/v2 ./apps/api/v2
COPY packages ./packages

# Install all dependencies (including dev, skip scripts)
RUN yarn config set httpTimeout 1200000 && \
    YARN_ENABLE_SCRIPTS=false yarn install

# Build application
RUN npx turbo prune --scope=@calcom/web --scope=@calcom/trpc --docker && \
    yarn workspace @calcom/trpc run build && \
    yarn --cwd packages/embeds/embed-core workspace @calcom/embed-core run build && \
    yarn --cwd apps/web workspace @calcom/web run build

# Clean up build artifacts and caches
RUN rm -rf node_modules/.cache .yarn/cache apps/web/.next/cache

# Stage 3: Production runtime
FROM node:20-alpine AS runner

WORKDIR /calcom

# Install runtime dependencies only
RUN apk add --no-cache \
    netcat-openbsd \
    wget \
    openssl \
    ca-certificates && \
    rm -rf /var/cache/apk/*

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy necessary files from builder
COPY --from=builder --chown=nextjs:nodejs /calcom/package.json /calcom/yarn.lock /calcom/.yarnrc.yml /calcom/turbo.json /calcom/i18n.json ./
COPY --from=builder --chown=nextjs:nodejs /calcom/.yarn ./.yarn
COPY --from=deps --chown=nextjs:nodejs /calcom/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /calcom/packages ./packages
COPY --from=builder --chown=nextjs:nodejs /calcom/apps/web ./apps/web
COPY --from=builder --chown=nextjs:nodejs /calcom/packages/prisma/schema.prisma ./prisma/schema.prisma
COPY --from=builder --chown=nextjs:nodejs /calcom/scripts ./scripts

# Make scripts executable
RUN chmod +x scripts/*

# Build-time URL replacement
ARG NEXT_PUBLIC_WEBAPP_URL=http://localhost:3000
ENV NEXT_PUBLIC_WEBAPP_URL=$NEXT_PUBLIC_WEBAPP_URL \
    BUILT_NEXT_PUBLIC_WEBAPP_URL=$NEXT_PUBLIC_WEBAPP_URL \
    NODE_ENV=production

RUN /calcom/scripts/replace-placeholder.sh http://NEXT_PUBLIC_WEBAPP_URL_PLACEHOLDER ${NEXT_PUBLIC_WEBAPP_URL}

# Switch to non-root user
USER nextjs

EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --retries=5 \
    CMD wget --spider http://localhost:3000 || exit 1

CMD ["/calcom/scripts/start.sh"]
