# ********** PRODUCTION ENVIRONMENT TEMPLATE **********
#
# IMPORTANT: This file contains common production environment variables.
# For a full list of available variables, refer to .env.example.
# 

# --- DATABASE ---
# In production, use your production database connection strings.
DATABASE_URL="postgresql://user:password@db-host:5432/dbname"
DATABASE_DIRECT_URL="postgresql://user:password@db-host:5432/dbname"

# --- WEB APP URLs ---
# Set these to your production domains.
NEXT_PUBLIC_WEBAPP_URL='https://app.yourdomain.com'
NEXT_PUBLIC_WEBSITE_URL='https://www.yourdomain.com'
NEXTAUTH_URL='https://app.yourdomain.com'

# --- SECURITY SECRETS ---
# CRITICAL: Generate long, random strings for these!
# You can use: `openssl rand -base64 32`
NEXTAUTH_SECRET='REPLACE_WITH_SECURE_RANDOM_STRING'
CALENDSO_ENCRYPTION_KEY='REPLACE_WITH_SECURE_RANDOM_STRING'

# --- API v2 ---
NEXT_PUBLIC_API_V2_URL="https://api.yourdomain.com/api/v2"
API_URL="https://api.yourdomain.com"
JWT_SECRET='REPLACE_WITH_SECURE_RANDOM_STRING'

# --- REDIS ---
# If using the Docker Compose setup, this should point to the redis service.
REDIS_URL="redis://redis:6379"

# --- EMAIL SETTINGS ---
EMAIL_FROM='notifications@yourdomain.com'
EMAIL_FROM_NAME='Cal.com'
EMAIL_SERVER_HOST='smtp.yourprovider.com'
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER='your-smtp-user'
EMAIL_SERVER_PASSWORD='your-smtp-password'

# --- ADDITIONAL PRODUCTION CONFIG ---
NODE_ENV=production
LOG_LEVEL=info
CALCOM_TELEMETRY_DISABLED=1
ORGANIZATIONS_ENABLED=1
